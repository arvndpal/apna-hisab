# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000

# Postgres (Supabase's transaction-mode connection pooler). This backend is the ONLY thing that
# connects to this database — a plain `pg` connection, not the Supabase SDK, so there's no RLS
# session; every query in src/sync and src/auth MUST filter by the authenticated user's id in
# application code. Never send this connection string to the mobile app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secrets for this backend's own JWTs (not Supabase's). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Firebase Auth (Google Sign-In). The app signs in via Firebase and sends this backend a Firebase
# ID token; this is how we verify it. Firebase Console → Project Settings → Service accounts →
# Generate new private key → paste the ENTIRE downloaded JSON as one line here (quoted).
FIREBASE_SERVICE_ACCOUNT=
