# Copy to .env and fill in real values. The app runs fully offline with none of these set —
# Milestones 1–3 need none of them; Auth/Sync/Ads/Premium read these once those milestones land.

# This app's own NestJS backend (/backend) — never Supabase directly (Milestone 4/5).
# Local dev on a physical device: run `adb reverse tcp:3000 tcp:3000` (same trick as Metro's 8081)
# and leave this as localhost.
BACKEND_URL=http://localhost:3000

# Google Sign-In via Firebase Auth (Milestone 4 — Auth & onboarding). This is the "Web client ID"
# (client_type 3) from android/app/google-services.json — Play Services needs it even though
# sign-in itself goes through Firebase. The Android client (type 1) doesn't need an env var; Play
# Services matches it automatically from google-services.json by package name + SHA-1.
GOOGLE_WEB_CLIENT_ID=

# AdMob (Milestone 9 — Monetisation)
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_NATIVE_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=

# Google Play Billing (Milestone 9 — Monetisation)
PLAY_PRODUCT_ID_PREMIUM_MONTHLY=premium_monthly
PLAY_PRODUCT_ID_PREMIUM_YEARLY=premium_yearly
PREMIUM_MONTHLY_PRICE_DISPLAY=₹[PRICE]/mo
PREMIUM_YEARLY_PRICE_DISPLAY=₹[PRICE]/yr

# Support & legal (shown in More/Settings, Welcome, Premium)
SUPPORT_CONTACT=
TERMS_URL=
PRIVACY_URL=
