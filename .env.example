# Copy to .env and fill in real values. The app runs fully offline with none of these set —
# Milestones 1–3 need none of them; Auth/Sync/Ads/Premium read these once those milestones land.

# Supabase (Milestone 5 — Sync engine)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sign-In (Milestone 4 — Auth & onboarding)
# Web client ID is the Supabase "Google" provider's client id; Android client ID is the
# OAuth client created for this app's package name + SHA-1 in Google Cloud Console.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# AdMob (Milestone 9 — Monetisation)
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_NATIVE_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=

# Google Play Billing (Milestone 9 — Monetisation)
PLAY_PRODUCT_ID_PREMIUM_MONTHLY=premium_monthly
PLAY_PRODUCT_ID_PREMIUM_YEARLY=premium_yearly
PREMIUM_MONTHLY_PRICE_DISPLAY=₹[PRICE]/mo
PREMIUM_YEARLY_PRICE_DISPLAY=₹[PRICE]/yr

# Support & legal (shown in More/Settings, Welcome, Premium)
SUPPORT_CONTACT=
TERMS_URL=
PRIVACY_URL=
